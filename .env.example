# ========================================================
# 🏛️ VARIABLES DE ENTORNO (EJEMPLO) - CHATBOT & DASHBOARD
# Copia este archivo como .env y configura tus credenciales
# ========================================================

# Puerto local del servidor (por defecto 3000 o 10000 en Render)
PORT=3000

# URL de la instancia n8n donde corre el workflow
N8N_URL=https://vps-5872382-x.dattaweb.com

# Clave de API de n8n para sincronización en tiempo real (n8n Settings > Public API)
# Dejar vacío si no se requiere polling de ejecuciones
N8N_API_KEY=tu_api_key_de_n8n_aqui

# ID del workflow en n8n
WORKFLOW_ID=03HiGPMmFsxuOmt1
